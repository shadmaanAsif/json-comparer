# Local development convenience only. The route rejects this wildcard in production
# and when the application is accessed through a non-loopback hostname.
FETCH_PROXY_ALLOWLIST=*
# Allows only localhost, 127.0.0.1, and ::1 over HTTP/HTTPS during local development.
# Private LAN addresses, public HTTP, production, and non-loopback app origins stay blocked.
FETCH_PROXY_ALLOW_LOCALHOST=true
