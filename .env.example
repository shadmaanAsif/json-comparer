# Optional public author name displayed in the application header.
NEXT_PUBLIC_APP_AUTHOR=Your Name

# Maximum accepted JSON document size in bytes. Client validation defaults to 10 MiB.
NEXT_PUBLIC_MAX_DOCUMENT_BYTES=10485760

# Required to enable Add via URL/cURL. Comma-separated exact hosts or explicit
# subdomain wildcards (for example: api.example.com,*.sandbox.example.com).
FETCH_PROXY_ALLOWLIST=api.example.com
# `*` is accepted only by a local, non-production development server.

# Development-only exception for http(s)://localhost, 127.0.0.1, and ::1.
# The route rejects this setting in production and from non-loopback app origins.
FETCH_PROXY_ALLOW_LOCALHOST=false

# Secure fetch policy. Credentials are stripped unless explicitly enabled.
FETCH_PROXY_ALLOW_CREDENTIALS=false
FETCH_PROXY_TIMEOUT_MS=10000
FETCH_PROXY_MAX_RESPONSE_BYTES=5242880
FETCH_PROXY_MAX_REDIRECTS=3
FETCH_PROXY_RATE_LIMIT=20
