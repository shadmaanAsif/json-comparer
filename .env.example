# Optional public author name displayed in the application header.
NEXT_PUBLIC_APP_AUTHOR=Your Name

# Public production URL used for canonical links, sitemap.xml, robots.txt, and
# generated social preview images. Defaults to http://localhost:3001 in development.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Maximum accepted JSON document size in bytes. Client validation defaults to 10 MiB.
NEXT_PUBLIC_MAX_DOCUMENT_BYTES=10485760

# Required to enable Add via URL/cURL. Comma-separated exact hosts, explicit subdomain
# wildcards, or top-level-domain wildcards (for example:
# api.example.com,*.sandbox.example.com,*.com,*.org,*.in,*.net). A TLD-wide wildcard
# allows any hostname under that TLD — loopback, private-LAN, link-local, multicast,
# reserved, and cloud-metadata addresses are still blocked regardless of which entry
# matches (that check is independent of the hostname allowlist), but a TLD-wide entry
# otherwise turns this into an open proxy for the public internet under that TLD, so
# choose it deliberately rather than as a shortcut. Combining a TLD-wide wildcard with
# FETCH_PROXY_ALLOW_CREDENTIALS=true forwards credentials to any matching host.
FETCH_PROXY_ALLOWLIST=api.example.com
# `*` (every hostname, unrestricted) is accepted only by a local, non-production
# development server.

# Development-only exception for http(s)://localhost, 127.0.0.1, and ::1.
# The route rejects this setting in production and from non-loopback app origins.
FETCH_PROXY_ALLOW_LOCALHOST=false

# Secure fetch policy. Credentials are stripped unless explicitly enabled.
FETCH_PROXY_ALLOW_CREDENTIALS=false
FETCH_PROXY_TIMEOUT_MS=10000
FETCH_PROXY_MAX_RESPONSE_BYTES=5242880
FETCH_PROXY_MAX_REDIRECTS=3
FETCH_PROXY_RATE_LIMIT=20
