    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.0.15",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.11",
    "jsdom": "27.2.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
